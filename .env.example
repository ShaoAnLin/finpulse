# FinPulse environment variables
# Copy this file to .env and fill in your values

# GitHub Personal Access Token (fine-grained, with models:read permission)
# Create at https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxx

# AI model (default: gpt-4o, alternatives: gpt-4o-mini, gpt-5)
FINPULSE_AI_MODEL=gpt-4o

# Telegram chat/group ID (get via @userinfobot or Telegram API)
FINPULSE_TELEGRAM_TARGET=-100xxxxxxxxxx

# OpenClaw Telegram settings (usually no changes needed)
FINPULSE_CHANNEL=telegram
FINPULSE_ACCOUNT_ID=default
