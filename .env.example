# FinPulse environment variables
# Copy this file to .env and fill in your values

# Groq API key (free tier) — create at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx

# Optional AI model override. Leave blank to automatically select an available model.
FINPULSE_AI_MODEL=

# LINE Messaging API channel access token (long-lived).
# Create a Messaging API channel in the LINE Developers Console, then issue
# a long-lived channel access token under the channel's "Messaging API" tab.
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxxxxxxxx

# LINE push target. For 1:1 delivery this is your own userId (starts with "U"),
# obtained from the bot's webhook "follow" event. Later this can be a group ID
# (starts with "C"), captured from a webhook event when the bot joins the group.
FINPULSE_LINE_TARGET=Uxxxxxxxxxxxxxxxx
